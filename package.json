{
  "name": "avado-client-ui",
  "version": "0.5.0",
  "private": true,
  "description": "Shared web UI for AVADO consensus-client packages",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "dev:rocketpool": "vite --config vite.rocketpool.config.ts",
    "build:rocketpool": "tsc --noEmit && vite build --config vite.rocketpool.config.ts",
    "dev:qtum": "vite --config vite.qtum.config.ts",
    "build:qtum": "tsc --noEmit && vite build --config vite.qtum.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && eslint . --max-warnings 0"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5",
    "@fontsource/public-sans": "^5",
    "@fontsource/sen": "^5",
    "@noble/hashes": "2.4.0",
    "ansi_up": "^6.0.6",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
