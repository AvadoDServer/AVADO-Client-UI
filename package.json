{
  "name": "avado-client-ui",
  "version": "0.4.0",
  "private": true,
  "description": "Shared web UI for AVADO consensus-client packages",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "dev:rocketpool": "vite --config vite.rocketpool.config.ts",
    "build:rocketpool": "tsc --noEmit && vite build --config vite.rocketpool.config.ts",
    "dev:qtum": "vite --config vite.qtum.config.ts",
    "build:qtum": "tsc --noEmit && vite build --config vite.qtum.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && eslint . --ext .ts,.tsx --max-warnings 0"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5",
    "@fontsource/public-sans": "^5",
    "@fontsource/sen": "^5",
    "@noble/hashes": "1.8.0",
    "ansi_up": "^6.0.6",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
